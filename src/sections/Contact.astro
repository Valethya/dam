<section class="contact" id="contact">
  <form class="contact-card" id="contact-form" novalidate>
    <div class="contact-step active" data-step="0">
      <h2 class="section-title contact-title">Conversemos</h2>
      <p class="contact-lead-text">Demos forma a tu próxima pieza cinematográfica.</p>
      <p class="contact-lead-text">Cuéntanos tu idea y te responderemos para conversar sobre ella.</p>
      <div class="contact-actions">
        <button class="button button--primary btn-start" type="button">Comenzar</button>
      </div>
    </div>

    <div class="contact-step" data-step="1">
      <h2 class="contact-question">¿Con quién tenemos el placer de hablar?</h2>
      <div class="field">
        <label class="field-label" for="form-name">Nombre</label>
        <input
          class="field-control"
          id="form-name"
          name="name"
          type="text"
          placeholder="Tu nombre y apellido"
          autocomplete="name"
          required
        />
        <span class="error-msg" id="error-name" role="alert">Ingresa tu nombre para continuar.</span>
      </div>
      <div class="contact-actions">
        <button class="button button--ghost btn-back" type="button">Atrás</button>
        <button class="button button--primary btn-next" type="button">Continuar</button>
      </div>
    </div>

    <div class="contact-step" data-step="2">
      <h2 class="contact-question" id="question-step2">¿Cuál es la visión o historia que quieres contar?</h2>
      <div class="field">
        <label class="field-label" for="form-project">Tu idea o proyecto</label>
        <textarea
          class="field-control"
          id="form-project"
          name="project"
          placeholder="Describe el proyecto, la marca o la historia que tienes en mente..."
          rows="4"
          required
        ></textarea>
        <span class="error-msg" id="error-project" role="alert">Cuéntanos un poco sobre tu proyecto.</span>
      </div>
      <div class="contact-actions">
        <button class="button button--ghost btn-back" type="button">Atrás</button>
        <button class="button button--primary btn-next" type="button">Continuar</button>
      </div>
    </div>

    <div class="contact-step" data-step="3">
      <h2 class="contact-question">¿Dónde podemos responderte?</h2>
      <div class="field">
        <label class="field-label" for="form-email">Correo</label>
        <input
          class="field-control"
          id="form-email"
          name="email"
          type="email"
          placeholder="nombre@ejemplo.com"
          autocomplete="email"
          required
        />
        <span class="error-msg" id="error-email" role="alert">Ingresa un correo electrónico válido.</span>
      </div>
      <div class="field contact-phone-field">
        <label class="field-label" for="form-phone">Teléfono <span>(opcional)</span></label>
        <input
          class="field-control"
          id="form-phone"
          name="phone"
          type="tel"
          placeholder="+56 9 1234 5678"
          autocomplete="tel"
        />
      </div>
      <div class="contact-actions">
        <button class="button button--ghost btn-back" type="button">Atrás</button>
        <button class="button button--primary btn-next" type="button">Revisar mensaje</button>
      </div>
    </div>

    <div class="contact-step" data-step="4">
      <h2 class="contact-question">Tu mensaje para DAM</h2>
      <div class="summary-card">
        <div class="summary-row"><span class="summary-label">Nombre</span><span class="summary-value" id="sum-name">-</span></div>
        <div class="summary-row"><span class="summary-label">Proyecto</span><span class="summary-value" id="sum-project">-</span></div>
        <div class="summary-row"><span class="summary-label">Correo</span><span class="summary-value" id="sum-email">-</span></div>
        <div class="summary-row"><span class="summary-label">Teléfono</span><span class="summary-value" id="sum-phone">-</span></div>
      </div>
      <span class="error-msg error-submit" id="error-submit" role="alert" aria-live="polite">
        No pudimos enviar tu mensaje. Intenta nuevamente.
      </span>
      <div class="contact-actions">
        <button class="button button--ghost btn-back" type="button">Atrás</button>
        <button class="button button--primary btn-confirm" type="submit">Enviar mensaje</button>
      </div>
    </div>

    <div class="contact-step" data-step="5">
      <h2 class="section-title contact-title">Mensaje enviado.</h2>
      <p class="contact-lead-text">Gracias por compartir tu proyecto. Revisaremos los detalles y nos comunicaremos contigo.</p>
      <div class="contact-actions">
        <button class="button button--primary btn-restart" type="button">Enviar otro mensaje</button>
      </div>
    </div>

    <div class="contact-honeypot" aria-hidden="true">
      <label for="form-website">Sitio web</label>
      <input id="form-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const steps = document.querySelectorAll<HTMLElement>('.contact-step');
  const submitButton = document.querySelector<HTMLButtonElement>('.btn-confirm');
  const submitError = document.querySelector<HTMLElement>('#error-submit');

  let currentStep = 0;
  const formData = {
    name: '',
    project: '',
    email: '',
    phone: '',
  };

  function initSteps() {
    steps.forEach((step, index) => {
      step.style.display = index === 0 ? 'flex' : 'none';
      step.classList.toggle('active', index === 0);
    });
  }

  function goToStep(stepIndex) {
    const activeStep = document.querySelector<HTMLElement>('.contact-step.active');
    const targetStep = document.querySelector<HTMLElement>(`.contact-step[data-step="${stepIndex}"]`);
    if (!targetStep || targetStep === activeStep) return;

    document.querySelectorAll<HTMLElement>('.error-msg').forEach((error) => {
      error.style.display = 'none';
    });

    activeStep?.classList.remove('active');
    window.setTimeout(() => {
      if (activeStep) activeStep.style.display = 'none';
      targetStep.style.display = 'flex';
      window.requestAnimationFrame(() => targetStep.classList.add('active'));
    }, 250);

    currentStep = stepIndex;

    if (stepIndex === 2) {
      const question = document.querySelector<HTMLElement>('#question-step2');
      if (question) question.textContent = `${formData.name}, ¿cuál es la visión o historia que quieres contar?`;
    }

    if (stepIndex === 4) renderSummary();
  }

  function validateCurrentStep() {
    if (currentStep === 1) {
      const name = document.querySelector<HTMLInputElement>('#form-name')?.value.trim() || '';
      if (!name) {
        document.querySelector<HTMLElement>('#error-name')?.style.setProperty('display', 'block');
        return false;
      }
      formData.name = name;
    }

    if (currentStep === 2) {
      const project = document.querySelector<HTMLTextAreaElement>('#form-project')?.value.trim() || '';
      if (project.length < 10) {
        document.querySelector<HTMLElement>('#error-project')?.style.setProperty('display', 'block');
        return false;
      }
      formData.project = project;
    }

    if (currentStep === 3) {
      const email = document.querySelector<HTMLInputElement>('#form-email')?.value.trim() || '';
      const phone = document.querySelector<HTMLInputElement>('#form-phone')?.value.trim() || '';
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!emailPattern.test(email)) {
        document.querySelector<HTMLElement>('#error-email')?.style.setProperty('display', 'block');
        return false;
      }

      formData.email = email;
      formData.phone = phone;
    }

    return true;
  }

  function renderSummary() {
    const values = {
      '#sum-name': formData.name,
      '#sum-project': formData.project,
      '#sum-email': formData.email,
      '#sum-phone': formData.phone || 'No indicado',
    };

    Object.entries(values).forEach(([selector, value]) => {
      const element = document.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    });
  }

  async function submitContact() {
    if (!submitButton || !submitError) return;

    submitButton.disabled = true;
    submitButton.textContent = 'Enviando...';
    submitError.style.display = 'none';

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...formData,
          website: document.querySelector<HTMLInputElement>('#form-website')?.value || '',
        }),
      });

      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message || 'No se pudo enviar el mensaje.');

      goToStep(5);
    } catch (error) {
      console.error(error);
      submitError.textContent = error instanceof Error
        ? error.message
        : 'No pudimos enviar tu mensaje. Intenta nuevamente.';
      submitError.style.display = 'block';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Enviar mensaje';
    }
  }

  function resetForm() {
    form?.reset();
    for (const key of Object.keys(formData) as Array<keyof typeof formData>) {
      formData[key] = '';
    }
    goToStep(0);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initSteps();

    document.querySelector('.btn-start')?.addEventListener('click', () => goToStep(1));

    document.querySelectorAll('.btn-next').forEach((button) => {
      button.addEventListener('click', () => {
        if (validateCurrentStep()) goToStep(currentStep + 1);
      });
    });

    document.querySelectorAll('.btn-back').forEach((button) => {
      button.addEventListener('click', () => goToStep(currentStep - 1));
    });

    document.querySelector('.btn-restart')?.addEventListener('click', resetForm);

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (currentStep === 4) submitContact();
    });

    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field-control').forEach((input) => {
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && input.tagName !== 'TEXTAREA') {
          event.preventDefault();
          input.closest('.contact-step')?.querySelector<HTMLButtonElement>('.btn-next')?.click();
        }
      });
    });
  });
</script>
