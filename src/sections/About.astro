<section class="about" id="about" aria-labelledby="about-title">
    <h2 class="about-section-title reveal" id="about-title">El estudio</h2>

    <div class="about-container">
        <div class="about-col reveal">
            <div class="about-trigger">
                <div class="about-header-text">
                    <span class="about-num">01</span>
                    <h3 class="about-subtitle">Enfoque</h3>
                </div>
                <span class="about-icon">+</span>
            </div>
            <div class="about-content">
                <p class="about-text">
                    DAM es un estudio audiovisual independiente. Convertimos ideas de marca en piezas cinematográficas — contenido, campañas y eventos pensados cuadro a cuadro, no solo grabados.
                </p>
            </div>
        </div>
        
        <div class="about-col reveal reveal-delay-1">
            <div class="about-trigger">
                <div class="about-header-text">
                    <span class="about-num">02</span>
                    <h3 class="about-subtitle">Método</h3>
                </div>
                <span class="about-icon">+</span>
            </div>
            <div class="about-content">
                <p class="about-text">
                    No partimos de una plantilla. Cada proyecto define su propio lenguaje — ritmo, luz, encuadre — según lo que esa marca necesita contar, no según lo que ya hicimos antes.
                </p>
            </div>
        </div>
        
        <div class="about-col reveal reveal-delay-2">
            <div class="about-trigger">
                <div class="about-header-text">
                    <span class="about-num">03</span>
                    <h3 class="about-subtitle">Por qué</h3>
                </div>
                <span class="about-icon">+</span>
            </div>
            <div class="about-content">
                <p class="about-text">
                    Porque una marca sin dirección visual propia se ve como cualquier otra. Nosotros construimos la mirada que la hace reconocible, incluso después de una sola pieza.
                </p>
            </div>
        </div>
    </div>
</section>

<script>
  function initAboutAccordion() {
    const cols = document.querySelectorAll('.about-col');
    cols.forEach(col => {
      const trigger = col.querySelector('.about-trigger');
      if (trigger) {
        trigger.addEventListener('click', () => {
          if (window.innerWidth < 768) {
            const isActive = col.classList.contains('active');
            
            // Close other columns to behave as a single-open accordion
            cols.forEach(c => c.classList.remove('active'));
            
            if (!isActive) {
              col.classList.add('active');
            }
          }
        });
      }
    });
  }

  // Run on load
  initAboutAccordion();

  // Reset active classes when resizing to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      document.querySelectorAll('.about-col').forEach(c => c.classList.remove('active'));
    }
  });
</script>