<section class="hero" id="hero">
  <video
    class="hero-media"
    poster="/videos/DRONLOGT1_poster.webp"
    preload="auto"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/videos/DRONLOGT1-web.mp4" type="video/mp4" />
  </video>

  <div class="hero-overlay"></div>

  <div class="hero-content">
    <h1 class="hero-title">
      <picture class="hero-logo-picture">
        <source media="(max-width: 767px)" srcset="/svg/logoheromovil.svg" />
        <img
          src="/svg/logoherodesk.svg"
          alt="DAM Films"
          class="hero-logo"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </h1>
  </div>
</section>
