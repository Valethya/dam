---
const services = [
  'Contenido de marca',
  'Campañas',
  'Eventos y matrimonios',
  'Piezas editoriales',
  'Dirección audiovisual',
];
---

<section class="services-band" aria-label="Servicios audiovisuales">
  <div class="services-band__track">
    <ul class="services-band__group">
      {services.map((service) => <li>{service}</li>)}
    </ul>
  </div>
</section>
