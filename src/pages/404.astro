---
import '../styles/main.scss';
---

<main class="error-main">
  <section class="error-page" aria-labelledby="error-message">
    <div class="error-content-video" aria-hidden="true">
      <video
        class="error-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        src="/videos/pulpo.mp4"
      ></video>
    </div>

    <div class="error-copy">
      <h1 class="error-message" id="error-message">
        <span class="error-sr-only">Error 404. </span>Aquí no hay nada.
      </h1>
      <a href="/" class="error-back-link">Volver</a>
    </div>
  </section>
</main>
