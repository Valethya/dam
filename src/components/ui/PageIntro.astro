<div class="page-intro" aria-hidden="true">
  <span class="page-intro__iris"></span>
</div>

<script>
  const root = document.documentElement;
  const intro = document.querySelector('.page-intro');
  const bootShield = document.querySelector('.page-intro-boot-shield');
  const heroVideo = document.querySelector('.hero-media');
  const heroLogo = document.querySelector('.hero-logo');

  if (intro instanceof HTMLElement) {
    root.classList.add('page-intro-active');

    const waitForEvent = (target, eventName, isReady) =>
      new Promise((resolve) => {
        if (!target || isReady()) {
          resolve();
          return;
        }

        const finish = () => {
          target.removeEventListener(eventName, finish);
          target.removeEventListener('error', finish);
          resolve();
        };

        target.addEventListener(eventName, finish, { once: true });
        target.addEventListener('error', finish, { once: true });
      });

    const videoReady = waitForEvent(
      heroVideo,
      'loadeddata',
      () => heroVideo instanceof HTMLVideoElement && heroVideo.readyState >= 2,
    );

    const posterReady = new Promise((resolve) => {
      if (!(heroVideo instanceof HTMLVideoElement) || !heroVideo.poster) {
        resolve();
        return;
      }

      const posterImage = new Image();
      const finish = () => {
        posterImage.removeEventListener('load', finish);
        posterImage.removeEventListener('error', finish);
        resolve();
      };

      posterImage.addEventListener('load', finish, { once: true });
      posterImage.addEventListener('error', finish, { once: true });
      posterImage.src = heroVideo.poster;
      if (posterImage.complete) finish();
    });

    const heroMediaReady = Promise.race([videoReady, posterReady]);

    const logoReady = waitForEvent(
      heroLogo,
      'load',
      () => heroLogo instanceof HTMLImageElement && heroLogo.complete,
    );

    const minimumDisplay = new Promise((resolve) => window.setTimeout(resolve, 350));
    const safetyTimeout = new Promise((resolve) => window.setTimeout(resolve, 3500));

    const finishIntro = () => {
      root.classList.remove('page-intro-boot', 'page-intro-active');
      bootShield?.remove();
      if (intro.isConnected) intro.remove();
    };

    Promise.race([
      Promise.all([heroMediaReady, logoReady, minimumDisplay]),
      safetyTimeout,
    ]).then(() => {
      const onAnimationEnd = (event) => {
        if (event.target !== intro) return;
        intro.removeEventListener('animationend', onAnimationEnd);
        finishIntro();
      };

      intro.addEventListener('animationend', onAnimationEnd);

      requestAnimationFrame(() => {
        if (!intro.isConnected) return;
        intro.classList.add('is-primed', 'is-opening');

        window.setTimeout(() => {
          requestAnimationFrame(() => {
            if (!intro.isConnected) return;

            bootShield?.remove();
            root.classList.remove('page-intro-boot');
          });
        }, 96);
      });

      window.setTimeout(finishIntro, 2200);
    });
  } else {
    root.classList.remove('page-intro-boot', 'page-intro-active');
    bootShield?.remove();
  }
</script>
